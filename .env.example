# OmniSight environment TEMPLATE — this file is TRACKED and committed.
# It must only ever contain PLACEHOLDERS. Real values live in a local,
# gitignored `.env` file. NEVER put a real secret in this file.
#
# Replace every CHANGE_ME_* value below with a freshly generated secret:
#   JWT_SECRET:        openssl rand -base64 48
#   ENCRYPTION_KEY:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   SUPER_ADMIN_PASSWORD: openssl rand -base64 18
#
# Production validation REJECTS these placeholders on purpose — do not use
# them in any real environment.




DATABASE_URL="postgresql://omnisight_user:omnisight_password@127.0.0.1:5433/omnisight_db"
DIRECT_URL="postgresql://omnisight_user:omnisight_password@127.0.0.1:5433/omnisight_db"
# অথবা আপনার ফ্রেমওয়ার্ক অনুযায়ী আলাদা ভেরিয়েবল হতে পারে, যেমন:
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=omnisight_user
DB_PASSWORD=omnisight_password
DB_NAME=omnisight_db

# Local Storage Configuration
# STORAGE_DRIVER selects the storage provider. Supported values:
#   local     — filesystem storage under STORAGE_LOCAL_PATH (default ./uploads)
#   supabase  — Supabase Storage buckets (requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
STORAGE_DRIVER=local
# Base directory for local filesystem storage (used when STORAGE_DRIVER=local).
# Relative paths are resolved against process.cwd(). Absolute paths are used as-is.
# Docker: set to /app/uploads to persist screenshots across container restarts.
STORAGE_LOCAL_PATH=./uploads

# ── Auth / encryption (PLACEHOLDERS — replace with generated values) ──
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_SECRET
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_32_BYTE_KEY_HEX



# ── Super Admin Bootstrap (PLACEHOLDERS — replace with unique values) ──
SUPER_ADMIN_EMAIL=CHANGE_ME_SUPER_ADMIN@example.invalid
SUPER_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD
SUPER_ADMIN_NAME=System Administrator
