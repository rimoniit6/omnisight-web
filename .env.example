# ─────────────────────────────────────────────────────────────
# OmniSight — Environment Variables
# (previously branded as WorkLensAI — technical env vars are unchanged)
#
# Copy this file to .env and fill in real values. NEVER commit .env.
# Only variables actually consumed by the application are listed below.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (Supabase) — the ONLY supported database ──────
# Production migrates with `prisma migrate deploy` (npm run db:deploy) —
# never `prisma db push`.
#
# On Supabase:
#   DATABASE_URL = the POOLED connection string (port 6543, ?pgbouncer=true)
#                  used by the application at runtime on Vercel serverless.
#   DIRECT_URL   = the DIRECT connection string (port 5432) used by Prisma
#                  Migrate / db push / admin operations (DDL must never run
#                  through the transaction pooler).
# On plain PostgreSQL hosts both can be the same URL — Prisma falls back to
# `url` when DIRECT_URL is absent (see prisma/schema.prisma).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/workai?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/workai?schema=public"

# ── Storage driver (screenshots + avatars) ───────────────────
# STORAGE_DRIVER=local    (default) — filesystem under uploads/ (self-hosted)
# STORAGE_DRIVER=supabase — Supabase Storage buckets. REQUIRED on Vercel:
#   the Vercel filesystem is read-only, so screenshots/avatars must live in
#   object storage. Screenshots go to a PRIVATE bucket (served only through
#   org-scoped, authenticated API routes); avatars go to the public bucket.
# SUPABASE_SERVICE_ROLE_KEY is a SERVER-ONLY secret — never a NEXT_PUBLIC_ var.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Super Admin Bootstrap ────────────────────────────────────
# Used by the production bootstrap command (scripts/bootstrap-super-admin.ts)
# and the dev-only seed to create the initial Super Admin. MUST be set — no
# fallback credentials exist and the bootstrap fails fast when missing.
# Generate a strong password: openssl rand -base64 18
# Bootstrap: npx tsx scripts/bootstrap-super-admin.ts
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SUPER_ADMIN_NAME=System Administrator

# ── JWT Settings ─────────────────────────────────────────────
# MUST be a cryptographically random string >= 16 chars (32+ recommended).
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
# Optional: session/JWT lifetime (default: 7d). Format: <number><s|m|h|d>
JWT_EXPIRES_IN=7d
# Optional: name of the httpOnly session cookie (default: worklens_token)
SESSION_COOKIE_NAME=worklens_token

# ── Secret Encryption at Rest (REQUIRED in production) ───────
# 32-byte key used to encrypt stored secrets (AI provider API keys) with
# AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be independent from JWT_SECRET. Missing/too-short fails fast in
# production. In development, if unset, a per-workspace key is generated and
# stored at .worklens/dev.key (gitignored). Rotating this key invalidates
# previously encrypted values (re-enter AI keys after rotation).
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ── Realtime / WebSocket mini-service ────────────────────────
# The live-updates service (mini-services/live-updates) is a SEPARATE
# long-running process that runs OUTSIDE Vercel (a VM/container with Node +
# Bun, or locally via `npm run dev:live`). It connects to the same database
# and validates the same JWT secret so browser socket connections can be
# authenticated. All three services (Next.js app, realtime service, database)
# must share the same JWT_SECRET.
#
# Optional: browser→socket endpoint. In dev, `npm run dev` sets this to
# http://localhost:3010 automatically. On Vercel, set it to the public URL of
# the deployed realtime service (wss://… or https://… behind the Caddy
# ?XTransformPort=3010 rewrite).
NEXT_PUBLIC_LIVE_UPDATES_URL=
# Optional: port the realtime service listens on (default: 3010)
LIVE_UPDATES_PORT=3010
# Optional: allowed browser origin for socket CORS (default: http://localhost:3000).
# MUST match the app origin in production, e.g. https://omnisight.example.com
ALLOWED_ORIGIN=

# ── Background jobs (best-effort on serverless — see DEPLOYMENT-SUPABASE-VERCEL.md) ──
# Optional: maintenance jobs interval in seconds (default: 3600 = hourly).
# JOBS_INTERVAL_SECONDS=3600
# Optional: project-time sync interval in seconds (default: 60, min: 15).
# PROJECT_TIME_SYNC_INTERVAL_SECONDS=60
# Optional: employee online-presence threshold (default: 300000 = 5 min).
# PRESENCE_ONLINE_THRESHOLD_MS=300000

# ── Desktop Agent build (admin-issued OmniSightAgent.exe) ────
# The EXE is built on a Windows CI host (GitHub Actions / self-hosted runner)
# or a local Windows dev box — NEVER on Vercel (serverless cannot run an
# Electron build). Optional vars consumed by the omnisight-agent build scripts:
#   AGENT_SERVER_URL        https:// URL baked into the installer (or set per
#                           org in Admin Panel → Settings → Agent Software)

# ── Test-only (never set in production) ──────────────────────
# Tests that spin throwaway databases use this base URL (a local Postgres).
# PG_TEST_BASE_URL=postgresql://postgres:123456@localhost:5432
