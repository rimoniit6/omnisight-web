# OmniSight environment TEMPLATE — this file is TRACKED and committed.
# It must only ever contain PLACEHOLDERS. Real values live in a local,
# gitignored `.env` file. NEVER put a real secret in this file.
#
# Replace every CHANGE_ME_* value below with a freshly generated secret:
#   JWT_SECRET:             openssl rand -base64 48
#   ENCRYPTION_KEY:         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   SUPER_ADMIN_PASSWORD:   openssl rand -base64 18
#
# src/lib/env-validator.ts validates this surface at startup (fail-fast for
# required vars, format checks for optional ones). Production validation
# REJECTS the CHANGE_ME_* placeholders on purpose — do not use them in any
# real environment.
#
# For the production checklist see .env.production.example; for the test
# environment contract see .env.test.example and tests/README.md.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the PLATFORM database (super admins, org
# metadata, the Global Device Routing index). CUSTOMER_DB orgs get their own
# analytics database at cutover; a single-DB (MANAGED) deployment uses this
# database for everything.
DATABASE_URL="postgresql://omnisight_user:omnisight_password@127.0.0.1:5433/omnisight_db"
# Used by the migration/backfill layer as the resolved platform connection.
# Point it at the same database as DATABASE_URL in dev; keep them equal in
# production unless your hosting splits read/write endpoints.
POSTGRES_PRISMA_URL="postgresql://omnisight_user:omnisight_password@127.0.0.1:5433/omnisight_db"
# Separated connection for Prisma migration tooling that must not be load
# balanced (e.g. managed PostgreSQL writes). Optional; defaults to DATABASE_URL.
# DIRECT_URL="postgresql://omnisight_user:omnisight_password@127.0.0.1:5433/omnisight_db"

# ── Auth / encryption (PLACEHOLDERS — replace with generated values) ──
# Min 16 chars; reject-if-placeholder. Never reuse across environments.
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_SECRET
# Required in production. 32 random bytes as hex (64 hex chars).
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_32_BYTE_KEY_HEX
# JWT lifetime. Optional; default is 7d. Accepts ms strings ("8h", "7d").
# JWT_EXPIRES_IN=7d
# Session cookie name. Optional; default is `worklens_token`.
# SESSION_COOKIE_NAME=worklens_token

# ── Super Admin Bootstrap (PLACEHOLDERS — replace with unique values) ──
SUPER_ADMIN_EMAIL=CHANGE_ME_SUPER_ADMIN@example.invalid
SUPER_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD
SUPER_ADMIN_NAME=System Administrator

# ── Local Storage Configuration ─────────────────────────────────────────────
# STORAGE_DRIVER selects the storage provider. Supported values:
#   local     — filesystem storage under STORAGE_LOCAL_PATH (default ./uploads)
#   supabase  — Supabase Storage buckets (requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
STORAGE_DRIVER=local
# Base directory for local filesystem storage (used when STORAGE_DRIVER=local).
# Relative paths are resolved against process.cwd(). Absolute paths are used as-is.
# Docker: set to /app/uploads to persist screenshots across container restarts.
STORAGE_LOCAL_PATH=./uploads
# Supabase storage (only when STORAGE_DRIVER=supabase). The service-role key is
# a SECRET — store it in your platform secret manager, never in the client.
# SUPABASE_URL=https://CHANGE_ME.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
# Dev-only escape hatch: allow http:// storage URLs (never enable in prod).
# OMNISIGHT_ALLOW_INSECURE_STORAGE_URLS=false

# ── Email / branding ────────────────────────────────────────────────────────
# Resend API key (optional — email features degrade gracefully when absent).
# RESEND_API_KEY=re_CHANGE_ME
# EMAIL_FROM_ADDRESS="OmniSight <no-reply@CHANGE_ME.example>"
# Canonical origin used in emails/webhooks. At least one of APP_URL /
# NEXT_PUBLIC_APP_URL should be set in production.
# APP_URL=https://CHANGE_ME.example
# NEXT_PUBLIC_APP_URL=https://CHANGE_ME.example

# ── WebSocket live updates ──────────────────────────────────────────────────
# Browser → live-updates WebSocket endpoint.
# In Docker: ws://localhost:3010 (container listens on 3010); on Vercel this is
# a wss:// URL proxied through a Next.js API route.
NEXT_PUBLIC_LIVE_UPDATES_URL=ws://localhost:3010

# ── AI / transcription ──────────────────────────────────────────────────────
# Local transcription service (optional; audio processing skips when absent).
# TRANSCRIPTION_SERVICE_URL=http://localhost:8001
# TRANSCRIPTION_API_KEY=CHANGE_ME_TRANSCRIPTION_API_KEY

# ── Notifications / observability ───────────────────────────────────────────
# Schema-drift alerting webhook (optional — drift is always reported via
# JobRun/job logs; this adds a Slack push).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
# Prometheus/metrics scrape token (optional). Min 8 chars.
# METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# ── Demo / seeding (dev tooling only) ───────────────────────────────────────
# Demo-First experience bootstrap + seed scripts. NEVER REAL USER DATA.
# DEMO_USER_EMAIL=demo@omnisight.example
# DEMO_USER_NAME=Demo Workspace
# DEMO_USER_PASSWORD=demo-password-please-change
# Gate idempotent seed/demo scripts (`SEED_ALLOWED=1`) — never on in prod.
# SEED_ALLOWED=0

# ── SSRF guard ──────────────────────────────────────────────────────────────
# Developer escape hatch allowing outbound probes to RFC1918/loopback targets.
# Default false; enabling it in production expands the SSRF attack surface.
# OMNISIGHT_ALLOW_PRIVATE_TARGETS=false

# ── Presence ────────────────────────────────────────────────────────────────
# Inactivity threshold (ms) before an employee shows as idle/away.
# PRESENCE_ONLINE_THRESHOLD_MS=300000

# ── Background job cadences (seconds; floors enforced at runtime) ───────────
# Hourly maintenance pass (consent expiry, retention, daily aggregations).
# JOBS_INTERVAL_SECONDS=3600
# Realtime project-time sync loop.
# PROJECT_TIME_SYNC_INTERVAL_SECONDS=60
# Screenshot thumbnail processing loop.
# SCREENSHOT_PROCESSING_INTERVAL_SECONDS=60
# SaaS device-count sync loop.
# SYNC_DEVICE_COUNT_INTERVAL_SECONDS=1800
# Infrastructure data-migration runner loop.
# INFRA_MIGRATION_INTERVAL_SECONDS=30

# ── Runtime ─────────────────────────────────────────────────────────────────
# NODE_ENV=development        # development | test | production
# NEXT_RUNTIME=nodejs         # nodejs | edge (set automatically by Next.js)