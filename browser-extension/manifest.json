{
  "manifest_version": 3,
  "name": "OmniSight Website Tracker",
  "version": "1.0.0",
  "key": "",
  "description": "Privacy-first website DOMAIN tracking for OmniSight. Only bare website domains (e.g. github.com) are reported to the OmniSight desktop agent — never full URLs, paths, queries, or page contents.",
  "permissions": ["tabs", "webNavigation", "nativeMessaging"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "website-tracker@worklens.ai",
      "strict_min_version": "109.0"
    }
  }
}
