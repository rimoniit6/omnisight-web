*.db
*.db-journal
*.db-wal
*.db-shm

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# local dev encryption key (auto-generated by src/lib/crypto.ts)
.worklens/
.gstack/

# ── Cleanup 2026-08-16 ────────────────────────────────────────────────────────
# E2E browser profile and Electron install (accidentally committed, now removed)
.e2e-fresh/
.e2e-install/

# Desktop agent build artifacts and binary outputs
omnisight-agent/build/
omnisight-agent/native-host-bin/
*.obj

# Database backups and dumps
backups/
db/*.bak-*

# Uploads directory
uploads/
# Allow the avatar serving route (Next.js app route, not uploaded files)
!src/app/uploads/

# Generated e2e + AI analysis outputs
.portal-e2e-results.json
falcon-*.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# ── Dependency lockfiles (canonical manager: bun) ───────────────────────────
# omnisight-web is bun-canonical: bun.lock is the committed, authoritative lock
# and matches the installed node_modules. npm-generated package-lock.json files
# are NOT authoritative here — committing one would create a second, possibly
# conflicting lock authority (the 88-byte stub was removed in Phase 0).
package-lock.json
