# ─────────────────────────────────────────────────────────────
# OmniSight — PRODUCTION Environment Variables
# (previously branded as WorkLensAI — technical env vars are unchanged)
#
# This template documents the variables a production deployment needs.
# Copy it to a SECRET store (Vercel Project Settings → Environment
# Variables, or .env.production on a self-hosted box) and fill in real
# values. NEVER commit real credentials.
#
# Recommended production stack: Vercel (web/API) + Supabase PostgreSQL +
# Supabase Storage + an external host for the realtime service.
# See DEPLOYMENT-SUPABASE-VERCEL.md for the full walkthrough.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────────────────────
# POOLED connection (Supabase dashboard → Connect → Transaction pooler):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Runtime/application traffic on Vercel serverless uses this URL.
DATABASE_URL=

# DIRECT connection (Supabase dashboard → Connect → Session pooler / Direct):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Used ONLY by Prisma Migrate / admin operations (never the pooler).
DIRECT_URL=

# ── Storage (Supabase Storage — REQUIRED on Vercel) ──────────
# The Vercel filesystem is read-only: screenshots (private bucket) and
# avatars (public bucket) must live in Supabase Storage.
STORAGE_DRIVER=supabase
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key (SERVER-ONLY — never expose to the browser, never a
# NEXT_PUBLIC_ var). Treat like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# ── Super Admin Bootstrap ────────────────────────────────────
# Used ONCE by `npx tsx scripts/bootstrap-super-admin.ts` after migrations.
# Idempotent — an existing account is never overwritten. Strong password
# required (>= 12 chars, upper+lower+digit).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────
# Cryptographically random, >= 16 chars (32+ recommended):
#   openssl rand -base64 48
JWT_SECRET=
# Optional (default 7d): <number><s|m|h|d>
# JWT_EXPIRES_IN=7d
# Optional (default worklens_token): httpOnly session cookie name
# SESSION_COOKIE_NAME=worklens_token

# ── Secret Encryption at Rest (REQUIRED) ─────────────────────
# 32-byte random key, independent from JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Missing/too-short fails fast in production. Rotating it invalidates stored
# secrets (re-enter AI provider keys).
ENCRYPTION_KEY=

# ── Realtime service (runs OUTSIDE Vercel) ───────────────────
# Public URL of the deployed mini-services/live-updates socket endpoint.
# Must share JWT_SECRET and DATABASE_URL with the app.
#   wss://live.omnisight.example.com        (direct websocket)
#   https://app.omnisight.example.com       (behind the Caddy ?XTransformPort=3010 rewrite)
NEXT_PUBLIC_LIVE_UPDATES_URL=
# Browser origin that may open sockets (must match the app origin):
ALLOWED_ORIGIN=
# Optional (default 3010): the socket service's listen port
# LIVE_UPDATES_PORT=3010

# ── Background jobs (best-effort on Vercel) ──────────────────
# The in-process scheduler (src/instrumentation.ts) runs while a serverless
# instance is warm; it is NOT a reliable job runner on Vercel. For
# deterministic cadence use Vercel Cron → `npm run jobs` (see the deployment
# doc) or a dedicated runner. Interval defaults are fine for most installs.
# JOBS_INTERVAL_SECONDS=3600
# PROJECT_TIME_SYNC_INTERVAL_SECONDS=60
# PRESENCE_ONLINE_THRESHOLD_MS=300000

# ── Desktop Agent ────────────────────────────────────────────
# Agent EXEs are built on a Windows CI host, never on Vercel.
# AGENT_SERVER_URL=https://app.omnisight.example.com

