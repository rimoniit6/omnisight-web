# OmniSight PRODUCTION environment TEMPLATE — this file is TRACKED and committed.
# It must only ever contain PLACEHOLDERS. Real values live in your platform
# secret manager (Kubernetes Secret / Vercel / Render / Fly.io env), NEVER in
# this file. Production validation in src/lib/env-validator.ts REJECTS the
# CHANGE_ME_* placeholders and fails startup on missing required variables.
#
# Generate real secrets with:
#   JWT_SECRET:             openssl rand -base64 48
#   ENCRYPTION_KEY:         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   SUPER_ADMIN_PASSWORD:   openssl rand -base64 18
#
# Required in production: DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY.
# See docs/DB-DEPLOYMENT.md for the deploy/migration runbook.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://omnisight_user:omnisight_password@prod-host:5433/omnisight_db?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://omnisight_user:omnisight_password@prod-host:5433/omnisight_db?sslmode=require"
# Only needed on providers that split read/write endpoints (managed Postgres).
# DIRECT_URL="postgresql://omnisight_user:omnisight_password@prod-host:5433/omnisight_db?sslmode=require"

# ── Auth / encryption (REQUIRED — replace with generated values) ──
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_SECRET
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_32_BYTE_KEY_HEX
JWT_EXPIRES_IN=7d
# SESSION_COOKIE_NAME=worklens_token

# ── Super Admin Bootstrap (REQUIRED pre-Deploy — replace with unique values) ──
SUPER_ADMIN_EMAIL=CHANGE_ME_SUPER_ADMIN@example.invalid
SUPER_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD
SUPER_ADMIN_NAME=System Administrator

# ── Storage ─────────────────────────────────────────────────────────────────
# STORAGE_DRIVER=local | supabase
STORAGE_DRIVER=local
# Docker/k8s: persist across restarts, e.g. /app/uploads (mounted volume).
STORAGE_LOCAL_PATH=./uploads
# When STORAGE_DRIVER=supabase:
# SUPABASE_URL=https://CHANGE_ME.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
# OMNISIGHT_ALLOW_INSECURE_STORAGE_URLS=false

# ── Email / branding ────────────────────────────────────────────────────────
# RESEND_API_KEY=re_CHANGE_ME
# EMAIL_FROM_ADDRESS="OmniSight <no-reply@CHANGE_ME.example>"
APP_URL=https://CHANGE_ME.example
# NEXT_PUBLIC_APP_URL=https://CHANGE_ME.example

# ── WebSocket live updates ──────────────────────────────────────────────────
# Browser → live-updates WebSocket endpoint.
# Docker: ws://app:3010; Vercel: wss://your-app.example (proxied).
NEXT_PUBLIC_LIVE_UPDATES_URL=wss://CHANGE_ME.example/live

# ── AI / transcription ──────────────────────────────────────────────────────
# TRANSCRIPTION_SERVICE_URL=http://localhost:8001
# TRANSCRIPTION_API_KEY=CHANGE_ME_TRANSCRIPTION_API_KEY

# ── Notifications / observability ───────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
# METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# ── Demo / seeding (MUST stay off in production) ────────────────────────────
# SEED_ALLOWED=0

# ── SSRF guard (MUST stay false in production) ──────────────────────────────
# OMNISIGHT_ALLOW_PRIVATE_TARGETS=false

# ── Presence ────────────────────────────────────────────────────────────────
# PRESENCE_ONLINE_THRESHOLD_MS=300000

# ── Background job cadences (seconds; floors enforced at runtime) ───────────
# JOBS_INTERVAL_SECONDS=3600
# PROJECT_TIME_SYNC_INTERVAL_SECONDS=60
# SCREENSHOT_PROCESSING_INTERVAL_SECONDS=60
# SYNC_DEVICE_COUNT_INTERVAL_SECONDS=1800
# INFRA_MIGRATION_INTERVAL_SECONDS=30

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# NEXT_RUNTIME=nodejs        # set automatically by Next.js